APP_PORT=8080
POSTGRES_PASSWORD=replace-with-a-strong-database-password
LSS_JWT_SECRET=replace-with-at-least-32-random-characters
LSS_ADMIN_USERNAME=admin
LSS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
